# ================================
# 🐍 PYTHON / DJANGO
# ================================

# Байт-код и кэш
__pycache__/
*.py[cod]
*$py.class
*.so

# Распространённые артефакты сборки
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Виртуальные окружения (ВСЕ варианты)
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Django-specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Миграции (если не хочешь коммитить пустые)
